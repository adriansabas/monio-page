---
import { Image } from 'astro:assets';
import background from '../../assets/images/hero-background.jpg';
import portrait from '../../assets/images/portrait-wood.jpg';
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="hero__background"
    src={background}
    alt=""
    widths={[800, 1200, 1600, 2074]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="container hero__inner">
    <div class="hero__portrait">
      <Image
        src={portrait}
        alt="Monika Wolińska – portret na tle drewnianych desek"
        widths={[420, 819]}
        sizes="(min-width: 60em) 26rem, 80vw"
        loading="eager"
      />
    </div>

    <div class="hero__content">
      <h1 id="hero-title"><span>Monika</span> <span>Wolińska</span></h1>
      <p class="hero__role">
        Psycholog, psychoterapeuta poznawczo-behawioralny i&nbsp;EMDR
        <span class="hero__note">(rekomendowany przez PTTEMDR)</span>
      </p>
      <p class="hero__meta">Warszawa <span aria-hidden="true">|</span> sesje online</p>
      <a class="button button--light" href="#kontakt">Umów spotkanie</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: clamp(7.5rem, 18vw, 8rem) clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Soft cream veil keeps the text readable on top of the photo */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgb(255 249 242 / 0.3),
      rgb(255 249 242 / 0.1)
    );
  }

  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .hero__portrait {
    width: min(100%, 26rem);
    margin-inline: auto;
    padding: clamp(0.5rem, 1.2vw, 0.9rem);
    background: var(--color-white);
    box-shadow: 0 1px 2px rgb(60 40 30 / 0.08), 0 16px 40px -20px rgb(60 40 30 / 0.3);
  }

  .hero__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
  }

  .hero__content {
    text-align: center;
  }

  h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(3rem, 2rem + 5vw, 6rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-warm);
  }

  h1 span {
    display: block;
  }

  .hero__role {
    max-width: 24em;
    margin-inline: auto;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    font-style: italic;
    line-height: 1.35;
  }

  .hero__note {
    display: block;
    margin-top: 0.35em;
    font-size: 0.85em;
  }

  .hero__meta {
    margin-block: 1.75rem 2.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  @media (min-width: 60em) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }

    .hero__content {
      text-align: left;
    }

    .hero__role {
      margin-inline: 0;
    }
  }
</style>
